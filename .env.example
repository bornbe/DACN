# ==============================================================================
# MẪU CẤU HÌNH MÔI TRƯỜNG OWASP WEB SCANNER (.env.example)
# Sao chép tệp này thành .env khi chạy cục bộ.
# CẢNH BÁO: Toàn bộ giá trị dưới đây chỉ là placeholder giả định cho môi trường
# development/lab, TUYỆT ĐỐI KHÔNG dùng cho production.
# ==============================================================================

APP_ENV=development
FLASK_DEBUG=0

# Khóa bí mật ứng dụng & JWT (Production bắt buộc >= 32 ký tự ngẫu nhiên, khác mặc định)
# Sinh khóa mới: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_EXAMPLE_DEV_ONLY_SECRET_KEY_NOT_FOR_PROD
JWT_SECRET_KEY=CHANGE_ME_EXAMPLE_DEV_ONLY_JWT_SECRET_NOT_FOR_PROD

# Cơ sở dữ liệu SQLite cục bộ
DATABASE_URL=sqlite:///scannerweb.db

# Khóa chủ AES-256-GCM bảo vệ dữ liệu nhạy cảm At-Rest (32 bytes dạng Base64 hoặc Hex 64 ký tự)
# Sinh khóa mới: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=CHANGE_ME_EXAMPLE_KEY_USE_RANDOM_32_BYTES_BASE64

# Cấu hình Reverse Proxy & giới hạn Single-Process Worker
# Để trống TRUSTED_PROXIES khi không đứng sau reverse proxy tin cậy
TRUSTED_PROXIES=
WORKER_PROCESSES=1

# Giới hạn mặc định cho Crawler & HTTP Client (Lab локаlhost/loopback)
DEFAULT_MAX_DEPTH=2
DEFAULT_MAX_PAGES=100
DEFAULT_REQUEST_TIMEOUT=10

# (Tùy chọn) Đường dẫn tệp font TrueType (.ttf) hỗ trợ Unicode tiếng Việt khi xuất PDF
REPORT_UNICODE_FONT_PATH=
